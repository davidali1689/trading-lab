# Copy to .env for local runs. Never commit real keys.
# Production keys live in Secrets Manager (trading-lab-vendor-keys).

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
FINNHUB_API_KEY=
UNUSUAL_WHALES_API_KEY=
GRAFANA_FEED_TOKEN=
# Swing congress catalyst is OFF by default (needs UW API sub).
# Set congress_catalyst_enabled=true in code / future env when subscribed.
TRADING_MODE=paper
ALLOW_LIVE_KEYS=false
USE_MOCK_BARS=false
# Daily dynamic watchlist size (Alpaca movers + most-actives). No hardcoded symbols.
WATCHLIST_SIZE=12

# Lambda only — OpenTofu sets this to trading-lab-vendor-keys ARN.
# Locally leave unset and use the keys above.
# SECRET_ARN=
